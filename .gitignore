### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

# 本地镜像仓库凭据/配置（勿提交）
registry.env
local-registry.env

# Asset bundles - exclude binary archives and pip freeze snapshots
asset-bundles/*/*.tgz
asset-bundles/*/pip-freeze.txt
# Expert Factory build outputs
dist/experts/*.expert.bundle
dist/experts/*.build.json
dist/experts/*.sha256
.workcopilot/

# Expert evaluation runtime outputs
evaluations/results/
.workcopilot/cache/
