{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workcopilot.local/schemas/expert-bundle-v1.schema.json",
  "title": "workcopilot.expert-bundle.v1",
  "type": "object",
  "required": [
    "schema_version",
    "expert_id",
    "expert_version",
    "bundle_format",
    "payload_digest"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "workcopilot.expert-bundle.v1"
    },
    "expert_id": { "type": "string" },
    "expert_version": { "type": "string" },
    "bundle_format": { "const": "zip" },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_commit": { "type": ["string", "null"] },
    "source_path": { "type": "string" },
    "build_tool_version": { "type": "string" },
    "runtime": {
      "type": "object",
      "properties": {
        "engine": { "type": "string" },
        "compatibility": { "type": "string" }
      }
    },
    "dev": { "type": "boolean" }
  }
}
