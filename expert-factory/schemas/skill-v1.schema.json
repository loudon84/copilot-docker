{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workcopilot.local/schemas/skill-v1.schema.json",
  "title": "workcopilot.skill.v1",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "description"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "workcopilot.skill.v1"
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "name": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9.-]+)?$"
    },
    "description": { "type": "string" },
    "triggers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scope": {
      "type": "object",
      "properties": {
        "includes": { "type": "array", "items": { "type": "string" } },
        "excludes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inputs": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "format": { "type": "string" },
        "contract": { "type": "string" }
      }
    },
    "tool_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "connector_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "access_mode": { "type": "string" },
        "data_classification": { "type": "string" }
      }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
