#!/usr/bin/env bash
# Unified WorkCopilot Expert Factory CLI entrypoint.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
EF="$ROOT/expert-factory"

if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
else
  echo "python3/python required" >&2
  exit 2
fi

export PYTHONPATH="$EF/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m workcopilot_expert_factory.cli "$@"
