UID=1000
GID=1000
# 构建期从 Git 拉取源码（git.superic.com 主分支为 master）
HERMES_WEBUI_REPO=http://git.superic.com/aiplatform/hermes-webui.git
HERMES_WEBUI_REF=master
HERMES_AGENT_REPO=http://git.superic.com/aiplatform/hermes-agent.git
HERMES_AGENT_REF=master
HERMES_VERSION=git-build
LOCAL_IMAGE_NAME=hermes-agent-webui:latest
HERMES_WEBUI_BIND=0.0.0.0
HERMES_WEBUI_PORT=8787
# Gateway 宿主机端口偏移：HERMES_GATEWAY_PORT = HERMES_BASE_PORT + HERMES_WEBUI_PORT
HERMES_BASE_PORT=20000
HERMES_GATEWAY_BIND=0.0.0.0
HERMES_GATEWAY_PORT=28787
HERMES_WEBUI_PASSWORD=replace-with-strong-password
HERMES_PROFILE=writer
HERMES_EXPERT=writer

# Hermes Agent API Server（nodeskclaw 接入，见 docs/agent-api-server.md）
API_SERVER_ENABLED=true
API_SERVER_KEY=replace-with-strong-api-key
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_MODEL_NAME=writer
API_SERVER_CORS_ORIGINS=
GATEWAY_ALLOW_ALL_USERS=true

HINDSIGHT_API_URL=http://hindsight.superic.com:8888
HINDSIGHT_BANK_ID=hermes-writer
INSTALL_GBRAIN=1
GBRAIN_REPO=http://git.superic.com/aiplatform/gbrain.git
GBRAIN_REF=master
BUN_VERSION=bun-v1.2.15

# 镜像构建加速（见 docs/build-image.md）
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
USE_CN_MIRRORS=1
APT_MIRROR=https://mirrors.aliyun.com/debian
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
BUILD_APT_PROXY=

# --- Finance BI (bi-strategic-office / hermes-finance-bi-plugin) ---
# Do NOT commit production DSN or passwords.
# SQL Server 2012+ (recommended for this deployment):
# FINANCE_BI_DSN=mssql+pymssql://readonly_user:PASSWORD@db-host:1433/bi_db
# Alternative ODBC (needs msodbcsql in image):
# FINANCE_BI_DSN=mssql+pyodbc://readonly_user:PASSWORD@db-host:1433/bi_db?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# PostgreSQL (optional):
# FINANCE_BI_DSN=postgresql+psycopg://readonly_user:password@host:5432/bi_db
FINANCE_BI_DSN=
FINANCE_BI_DIALECT=mssql
FINANCE_BI_TDS_VERSION=7.0
FINANCE_BI_CATALOG_PATH=/data/hermes/finance-bi/semantic
FINANCE_BI_POLICY_PATH=/data/hermes/finance-bi/policies
FINANCE_BI_ALLOWED_SCHEMAS=dbo,bi_finance,bi_sales
FINANCE_BI_ALLOWED_ENTITIES=
# 示例（按需）：FINANCE_BI_ALLOWED_ENTITIES=101,104
FINANCE_BI_DEFAULT_CURRENCY=HKD
FINANCE_BI_TIMEZONE=Asia/Hong_Kong
FINANCE_BI_QUERY_TIMEOUT_SECONDS=30
FINANCE_BI_DEFAULT_LIMIT=200
FINANCE_BI_HARD_LIMIT=5000
FINANCE_BI_STATE_DB=/data/hermes/finance-bi/state/finance_bi.db
FINANCE_BI_EXPORT_DIR=/data/hermes/workspace/exports/bi
FINANCE_BI_MASK_SENSITIVE=true
FINANCE_BI_REVEAL_FILTERED_SENSITIVE=true
# 内部运营核对客户明细时可设 FINANCE_BI_MASK_SENSITIVE=false
